# Copy to .env and fill with Razorpay Dashboard → Test Mode API keys.
# Never use rzp_live_ keys in this project without explicit approval.

RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourKeySecret

# Optional. A local value is generated when this is unset.
COUCHKRAFT_AUTH_SECRET=change-me-in-local-dev
